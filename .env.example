# Public site URL used for metadata / canonical tags
NEXT_PUBLIC_SITE_URL=https://www.vedvikmachinery.com

# ── Sanity CMS ────────────────────────────────────────────────────
# Get these from sanity.io/manage after creating your (free) project.
# Until they are set, the site serves the content committed in lib/*.ts,
# so nothing breaks.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Only needed locally, to run scripts/seed-sanity.mjs once.
# Sanity → API → Tokens → "Editor". Never commit the real value.
SANITY_WRITE_TOKEN=
